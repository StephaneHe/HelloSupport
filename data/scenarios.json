    "running": {"postgres": "running", "nginx": "running", "redis": "running"},
    "redis_down": {"postgres": "running", "nginx": "running", "redis": "stopped"},
    "tool_error": {"postgres": "error", "nginx": "error", "redis": "error"}
  }
