# Copy to .env (gitignored). No secret is needed: everything runs locally.
# LM Studio OpenAI-compatible endpoint
HS_LLM_BASE_URL=http://localhost:1234/v1
# Model ids as listed by `lms ls` / GET /v1/models
HS_MODEL_SLM=qwen/qwen3-4b-2507
HS_MODEL_LARGE=qwen2.5-7b-instruct
# Model used by `ask` when --model is not given: slm | large | <model id>
HS_MODEL_DEFAULT=large
# Timeout of one LLM call, in seconds
HS_LLM_TIMEOUT_S=120
# Simulated service states: stopped | running | redis_down | tool_error (overridden by --scenario)
# HS_SCENARIO=stopped
# Optional: file holding the scenario name, re-read at each status call (used by the web demo;
# takes priority over HS_SCENARIO and --scenario)
# HS_SCENARIO_FILE=
# Web demo: per-question timeout and maximum wait in the queue, in seconds
# HS_WEB_TIMEOUT_S=240
# HS_WEB_QUEUE_TIMEOUT_S=300
# Web demo: base URL of a documentation site for source links (see README, Web demo)
# HS_DOCS_URL=
