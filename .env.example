# Copy to .env (gitignored). No secret is needed: everything runs locally.
# LM Studio OpenAI-compatible endpoint
HS_LLM_BASE_URL=http://localhost:1234/v1
# Model ids as listed by `lms ls` / GET /v1/models
HS_MODEL_SLM=qwen/qwen3-4b-2507
HS_MODEL_LARGE=qwen2.5-7b-instruct
# Model used by `ask` when --model is not given: slm | large | <model id>
HS_MODEL_DEFAULT=large
